{
  "name": "cgoing-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker start love-island-pg || docker run -d --name love-island-pg -e POSTGRES_PASSWORD=island -e POSTGRES_USER=island -e POSTGRES_DB=love_island -p 5432:5432 -v love-island-pgdata:/var/lib/postgresql/data postgres:17-alpine"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-zod": "^0.8.3",
    "leva": "^0.10.1",
    "lucide-react": "^1.28.0",
    "maath": "^0.10.8",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
